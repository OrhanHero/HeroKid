<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-Smoke-Tests: die gefährlichste Bug-Klasse dieses Projekts sind XAML-LAUFZEIT-Fehler
       (XamlParseException - kompiliert sauber, crasht erst beim Laden, siehe "Hard-won gotchas"
       in CLAUDE.md), und kein Unit-Test in LernTor.Tests kann sie fangen. Dieses Projekt braucht
       net10.0-windows + WPF. Bauen lässt es sich auch unter Linux (EnableWindowsTargeting, siehe
       Directory.Build.props), AUSFÜHREN nur auf Windows - also im windows-latest-CI-Lauf. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <RootNamespace>LernTor.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- [WpfFact]/[WpfTheory]: führt Tests auf einem STA-Thread mit WPF-Dispatcher aus -
         Voraussetzung, um WPF-Controls überhaupt instanziieren zu dürfen. -->
    <PackageReference Include="Xunit.StaFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LernTor.App\LernTor.App.csproj" />
  </ItemGroup>

</Project>
