<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>LernTor.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Repositories nehmen einen ILogger entgegen; die Tests reichen NullLogger durch.
         Kommt zwar ohnehin transitiv über EF Core, steht hier aber ausdrücklich, damit ein
         Paket-Update von EF Core die Tests nicht überraschend zerlegt.
         Version 10.0.5 statt 8.0.2: LLamaSharp 0.27.0 (über LernTor.ContentGen) verlangt bereits
         >= 10.0.5 - 8.0.2 war ein Downgrade und ließ die Wiederherstellung mit NU1605 scheitern. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LernTor.Core\LernTor.Core.csproj" />
    <ProjectReference Include="..\..\src\LernTor.ContentGen\LernTor.ContentGen.csproj" />
    <ProjectReference Include="..\..\src\LernTor.News\LernTor.News.csproj" />
    <!-- Für die Schema-Abgleich-Tests (SqliteSchemaUpdater) gegen echte SQLite-Temp-Dateien. -->
    <ProjectReference Include="..\..\src\LernTor.Data\LernTor.Data.csproj" />
  </ItemGroup>

</Project>
