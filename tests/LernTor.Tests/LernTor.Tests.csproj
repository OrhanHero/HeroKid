<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>LernTor.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Repositories nehmen einen ILogger entgegen; die Tests reichen NullLogger durch.
         Kommt zwar ohnehin transitiv über EF Core, steht hier aber ausdrücklich, damit ein
         Paket-Update von EF Core die Tests nicht überraschend zerlegt. Die Version steht zentral in
         Directory.Packages.props (früher lag sie hier auf 8.0.2, während LLamaSharp schon
         >= 10.0.5 verlangte - NU1605). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LernTor.Core\LernTor.Core.csproj" />
    <ProjectReference Include="..\..\src\LernTor.ContentGen\LernTor.ContentGen.csproj" />
    <ProjectReference Include="..\..\src\LernTor.News\LernTor.News.csproj" />
    <!-- Für die Schema-Abgleich-Tests (SqliteSchemaUpdater) gegen echte SQLite-Temp-Dateien. -->
    <ProjectReference Include="..\..\src\LernTor.Data\LernTor.Data.csproj" />
  </ItemGroup>

</Project>
