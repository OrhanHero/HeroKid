<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LernTor.ContentGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LernTor.Core\LernTor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Für TeacherImport: PDF-/Word-Textextraktion (reine .NET-Bibliotheken, keine Windows-Abhängigkeit).
         Version 1.7.0 mit expliziten Sub-Paketen (Versionen in Directory.Packages.props),
         um NU1603-Warnungen durch fehlende Abhängigkeiten (Core, Tokens, Fonts, Tokenization)
         bei der alten 0.1.9-alpha zu vermeiden. -->
    <PackageReference Include="UglyToad.PdfPig" />
    <PackageReference Include="UglyToad.PdfPig.Core" />
    <PackageReference Include="UglyToad.PdfPig.Tokens" />
    <PackageReference Include="UglyToad.PdfPig.Fonts" />
    <PackageReference Include="UglyToad.PdfPig.Tokenization" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Einzige KI-Anbindung in LernTor, komplett lokal (kein Cloud-Konto, keine Kosten, Daten
         verlassen nie den PC): LLamaSharp lädt eine GGUF-Modelldatei direkt im App-Prozess.
         LLamaSharp.Backend.Cpu liefert die nativen
         llama.cpp-Binaries (kein GPU-Backend, um keine CUDA-Abhängigkeit ins Kiosk-Setup zu bringen). -->
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

</Project>
