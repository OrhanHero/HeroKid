<Window x:Class="LernTor.App.Views.ExamEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klausur eintragen"
        Width="520" MinWidth="420"
        Height="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">
    <!-- Bewusst schlicht und gross geschrieben: dieses Fenster benutzen auch die Kinder, und es
         oeffnet sich mitten im Kiosk-Betrieb. Kein Loeschen, kein Bearbeiten fremder Eintraege -
         nur "neuen Termin anlegen".

         Layout mit fest verankerter Knopfzeile statt eines einzelnen StackPanels in einem Fenster
         fester Hoehe: vorher lagen "Abbrechen" und "Eintragen" unterhalb des sichtbaren Bereichs,
         das Fenster war schlicht zu niedrig fuer seinen Inhalt. Nur die Zahl zu erhoehen haette
         das bei groesserer Schrift oder anderer Anzeigeskalierung sofort wieder gebrochen -
         deshalb: Inhalt scrollt, Knoepfe bleiben immer sichtbar. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="📅 Klausur eintragen" Style="{StaticResource HeadlineText}"
                           FontSize="26" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock Text="Trag den Termin ein, sobald du ihn kennst. Ab einer Woche vorher übst du in dem Fach automatisch mehr."
                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16" />

                <TextBlock Text="Fach" Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,0,4" />
                <ComboBox x:Name="SubjectBox" Margin="0,0,0,12" Padding="6" FontSize="14" />

                <TextBlock Text="Wann?" Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,0,4" />
                <DatePicker x:Name="DateBox" Margin="0,0,0,12" FontSize="14" />

                <TextBlock Text="Titel (z.B. „Klassenarbeit Nr. 2“)" Style="{StaticResource BodyText}"
                           FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBox x:Name="TitleBox" Margin="0,0,0,12" Padding="6" FontSize="14" />

                <TextBlock Text="Was kommt dran? (freiwillig)" Style="{StaticResource BodyText}"
                           FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                <!-- AcceptsReturn: hier soll Enter eine neue Zeile machen, nicht absenden. Der
                     Standard-Knopf greift trotzdem, sobald der Fokus woanders steht. -->
                <TextBox x:Name="TopicsBox" Margin="0,0,0,8" Padding="6" FontSize="14"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" FontSize="12"
                       Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource RoundedButton}" Margin="0,0,8,0"
                        MinWidth="120" Click="Cancel_Click" />
                <Button Content="✓ Eintragen" Style="{StaticResource RoundedButton}"
                        MinWidth="140" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
