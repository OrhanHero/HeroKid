<UserControl x:Class="LernTor.App.Views.CourseOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization"
             xmlns:controls="clr-namespace:LernTor.App.Controls">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,48,32,12" HorizontalAlignment="Center" MaxWidth="1000">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_CourseTitle]}"
                       Style="{StaticResource HeadlineText}" FontSize="30" TextAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_CourseIntro]}"
                       Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <ProgressBar Style="{StaticResource ChildProgressBar}" Height="10" Margin="0,12,0,0"
                         Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
            <TextBlock Text="{Binding OverallDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="14" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <ItemsControl ItemsSource="{Binding Lessons}" HorizontalAlignment="Center" MaxWidth="1000">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Ein Zeichen aus der Lektion als Vorschau; Lektionen ohne
                                     Zeichen (etwa Umwelt) lassen die Spalte einfach leer. -->
                                <controls:TrafficSignVisual Grid.Column="0" Width="56" Height="56"
                                                            Margin="0,0,16,0" VerticalAlignment="Center"
                                                            Sign="{Binding Sample}"
                                                            Visibility="{Binding Sample, Converter={StaticResource NullToVis}}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <Border Background="{StaticResource TileMintBrush}" CornerRadius="10"
                                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_CourseRecommended]}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Intro}" Style="{StaticResource BodyText}"
                                               FontSize="13" TextWrapping="Wrap" Margin="0,3,0,4" />
                                    <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource BodyText}"
                                               FontSize="12" Opacity="0.85" />
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_CourseOpen]}"
                                        Style="{StaticResource RoundedButton}" FontSize="14" Padding="20,8"
                                        Command="{Binding DataContext.OpenLessonCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,28"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                Style="{StaticResource RoundedButton}"
                Background="{StaticResource TextSecondaryBrush}"
                Command="{Binding BackCommand}" />
    </Grid>
</UserControl>
