<UserControl x:Class="LernTor.App.Views.PauseModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">

        <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="720" Padding="48,40">
            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="🏖️" FontSize="64" TextAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Pause_Title]}"
                           Style="{StaticResource HeadlineText}" FontSize="34" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Das Enddatum ausgeschrieben: Eltern erkennen sofort, ob das eingetragene Datum
                     wirklich das gemeinte ist. -->
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyText}"
                           FontSize="20" Margin="0,0,0,4">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FormatWithArg}">
                            <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="[Pause_Until]" />
                            <Binding Path="UntilDisplay" Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <TextBlock Text="{Binding RemainingDisplay, Mode=OneWay}"
                           Style="{StaticResource SubtitleText}" FontSize="17" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,28" />

                <!-- Der Normalfall in den Ferien: LernTor beenden, PC gehoert dem Kind. -->
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Pause_UnlockPc]}"
                        Style="{StaticResource RoundedButton}" Background="{StaticResource SuccessBrush}"
                        FontSize="22" Padding="40,18" HorizontalAlignment="Center"
                        Command="{Binding UnlockPcCommand}" />

                <!-- Freiwilliges Lernen soll die Pause nicht verbieten - bewusst zweite Wahl. -->
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Pause_PracticeAnyway]}"
                        Style="{StaticResource RoundedButton}" Background="{StaticResource TextSecondaryBrush}"
                        FontSize="16" Padding="22,10"
                        HorizontalAlignment="Center" Margin="0,14,0,0"
                        Command="{Binding PracticeAnywayCommand}" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Pause_ParentHint]}"
                           Style="{StaticResource BodyText}" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Opacity="0.75" Margin="0,26,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
