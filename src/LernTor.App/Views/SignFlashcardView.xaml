<UserControl x:Class="LernTor.App.Views.SignFlashcardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization"
             xmlns:controls="clr-namespace:LernTor.App.Controls">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">

        <!-- ===================== Karte ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsFinished, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="640" Margin="24,56,24,24">

                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}"
                           FontSize="24" TextAlignment="Center" />
                <TextBlock Text="{Binding PositionDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                           FontSize="14" TextAlignment="Center" Margin="0,2,0,16" />

                <Border Style="{StaticResource CardBorder}" Padding="28" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:TrafficSignVisual Width="200" Height="200" Sign="{Binding CurrentSign}" />

                        <!-- Rückseite: erst nach dem Umdrehen -->
                        <StackPanel MaxWidth="480" Margin="0,20,0,0"
                                    Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CurrentSign.Name}" FontSize="21" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" TextAlignment="Center"
                                       Margin="0,2,0,10" Opacity="0.7">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FormatWithArg}">
                                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="[Fs_Number]" />
                                        <Binding Path="CurrentSign.Number" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentSign.Meaning}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="{Binding CurrentSign.Hint}" Style="{StaticResource BodyText}"
                                       FontStyle="Italic" FontSize="13" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,10,0,0" Opacity="0.85" />

                            <Border Background="{StaticResource TileMintBrush}" CornerRadius="10" Padding="10,4"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Visibility="{Binding CurrentSign.RelevantForBicycle, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="🚲 " />
                                    <Run Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ForBicycle], Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Vorderseite: nur umdrehen -->
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ShowAnswer]}"
                        Style="{StaticResource RoundedButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Visibility="{Binding IsRevealed, Converter={StaticResource InverseBoolToVis}}"
                        Command="{Binding RevealCommand}" />

                <!-- Rückseite: Selbsteinschätzung. Zählt bewusst NICHT in den Lernstand -
                     dafür ist das Quiz da (siehe SignFlashcardViewModel). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}">
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_NotKnown]}"
                            Style="{StaticResource RoundedButton}"
                            Background="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                            Command="{Binding NotKnownCommand}" />
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Known]}"
                            Style="{StaticResource RoundedButton}"
                            Background="{StaticResource SuccessBrush}"
                            Command="{Binding KnownCommand}" />
                </StackPanel>

                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                        Style="{StaticResource RoundedButton}" FontSize="14" Padding="18,8"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Center" Margin="0,20,0,0"
                        Command="{Binding BackCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Stapel durch ===================== -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="🎉" FontSize="64" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}"
                       FontSize="26" TextAlignment="Center" Margin="0,0,0,24" />
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                    Style="{StaticResource RoundedButton}" HorizontalAlignment="Center"
                    Command="{Binding BackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
