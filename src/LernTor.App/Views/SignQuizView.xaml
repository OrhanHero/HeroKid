<UserControl x:Class="LernTor.App.Views.SignQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization"
             xmlns:controls="clr-namespace:LernTor.App.Controls">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">

        <!-- ===================== Laufendes Quiz ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsFinished, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="720" Margin="24,56,24,24">

                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}"
                           FontSize="24" TextAlignment="Center" />
                <TextBlock Text="{Binding PositionDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                           FontSize="14" TextAlignment="Center" Margin="0,2,0,16" />

                <!-- Das Zeichen selbst - die eigentliche Frage -->
                <Border Style="{StaticResource CardBorder}" Padding="24" HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <controls:TrafficSignVisual Width="200" Height="200" Sign="{Binding CurrentSign}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    IsEnabled="{Binding IsEnabled}"
                                    Command="{Binding DataContext.ChooseCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <!-- Nach der Antwort: richtige Option grün, die falsch gewählte rot.
                                         Beides gleichzeitig, damit sichtbar wird, was stattdessen
                                         gestimmt hätte. -->
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWrongChoice}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Auflösung: erscheint erst nach der Antwort, sonst wäre sie die Lösung -->
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,10,0,0"
                        Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Feedback}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{Binding WasCorrect, Converter={StaticResource BoolToSuccessBrushConverter}}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meaning}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource BodyText}" FontStyle="Italic"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" />
                    </StackPanel>
                </Border>

                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Next]}"
                        Style="{StaticResource RoundedButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVis}}"
                        Command="{Binding NextCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Ergebnis ===================== -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="🚦" FontSize="64" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}"
                       FontSize="28" TextAlignment="Center" />
            <TextBlock Text="{Binding ResultDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="22" TextAlignment="Center" Margin="0,8,0,24" />
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                    Style="{StaticResource RoundedButton}" HorizontalAlignment="Center"
                    Command="{Binding BackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
