<UserControl x:Class="LernTor.App.Views.TheoryHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Kopf ===================== -->
        <StackPanel Grid.Row="0" Margin="32,48,32,12" HorizontalAlignment="Center" MaxWidth="1000">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_TheoryTitle]}"
                       Style="{StaticResource HeadlineText}" FontSize="30" TextAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_TheoryIntro]}"
                       Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding OverallDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="15" TextAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LastExamDisplay, Mode=OneWay}" Style="{StaticResource BodyText}"
                       FontSize="13" TextAlignment="Center" Margin="0,4,0,0"
                       Visibility="{Binding HasLastExam, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000">

                <!-- ===== Schwachstellen-Trainer steht oben: wer selbst wählt, übt das, was
                     ohnehin schon sitzt. ===== -->
                <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,0,0,14"
                        Background="{StaticResource TileRoseBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_WeakSpots]}"
                                       FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding WeakSpotHint, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_WeakSpotsStart]}"
                                Style="{StaticResource RoundedButton}"
                                IsEnabled="{Binding ExamPossible}"
                                Command="{Binding StartWeakSpotsCommand}" />
                    </Grid>
                </Border>

                <!-- ===== Prüfungssimulation ===== -->
                <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,0,0,20"
                        Background="{StaticResource TileSandBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Exam]}"
                                       FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ExamHint, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamStart]}"
                                Style="{StaticResource RoundedButton}"
                                IsEnabled="{Binding ExamPossible}"
                                Command="{Binding StartExamCommand}" />
                    </Grid>
                </Border>

                <!-- ===== Die vierzehn Sachgebiete ===== -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_TheoryTopics]}"
                           FontSize="22" FontWeight="SemiBold" Margin="4,0,0,10"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ItemsControl ItemsSource="{Binding Topics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <!-- Nur belastbar gemessene Gebiete werden so markiert -
                                                 zwei falsche Antworten machen noch keine Schwachstelle. -->
                                            <Border Background="{StaticResource TileRoseBrush}" CornerRadius="10"
                                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsWeak, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_TheoryWeakMark]}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource ChildProgressBar}" Height="8"
                                                     Minimum="0" Maximum="1" Margin="0,8,0,0"
                                                     Value="{Binding Fraction, Mode=OneWay}" />
                                        <TextBlock Text="{Binding ProgressDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_TheoryPractice]}"
                                            Style="{StaticResource RoundedButton}" FontSize="14" Padding="18,8"
                                            Command="{Binding DataContext.PracticeTopicCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="16" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,28"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                Style="{StaticResource RoundedButton}"
                Background="{StaticResource TextSecondaryBrush}"
                Command="{Binding BackCommand}" />
    </Grid>
</UserControl>
