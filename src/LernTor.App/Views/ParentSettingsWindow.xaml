<Window x:Class="LernTor.App.Views.ParentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LernTor.App.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_LoginTitle]}"
        Width="760" Height="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <!-- Gemeinsame Berichts-Zeile (Label + Ampel-Balken + Quote): genutzt vom Fach-Bericht
             UND der Themen-Heatmap ("Schwächste Themen"), damit beide identisch aussehen. -->
        <DataTemplate x:Key="ReportRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Rate, Mode=OneWay}"
                             Height="14" BorderThickness="0" Background="{StaticResource ProgressTrackBrush}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWeak}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Grid.Column="2" Text="{Binding RateDisplay}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <!-- Zwei Zeilen: Inhalt scrollt, die Knopfzeile bleibt unten stehen. Vorher lagen
         "Speichern"/"Schliessen" MITTEN im Scrollbereich - seit dort Hausaufgaben, Klausuren,
         Nachrichtenquellen und die Lesetext-Verwaltung dazugekommen sind, lagen sie irgendwo in
         der Mitte einer sehr langen Seite. Wer unten etwas aendert, soll nicht erst wieder
         hochscrollen muessen, um zu speichern. -->
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Login / Ersteinrichtung -->
        <StackPanel VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_LoginTitle]}"
                       Style="{StaticResource HeadlineText}" FontSize="28" Margin="0,0,0,20" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_SetupPasswordPrompt]}"
                       Style="{StaticResource BodyText}" Margin="0,0,0,8"
                       Visibility="{Binding IsFirstTimeSetup, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_PasswordPrompt]}"
                       Style="{StaticResource BodyText}" Margin="0,0,0,8"
                       Visibility="{Binding IsFirstTimeSetup, Converter={StaticResource InverseBoolToVis}}" />
            <PasswordBox x:Name="PasswordInput" FontSize="18" Padding="10" KeyDown="PasswordInput_KeyDown" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Login]}"
                        Style="{StaticResource RoundedButton}" Margin="0,0,12,0" HorizontalAlignment="Left"
                        Click="LoginButton_Click" />
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_UnlockAndExit]}"
                        Style="{StaticResource RoundedButton}" Background="{StaticResource ErrorBrush}" HorizontalAlignment="Left"
                        Click="UnlockAndExitButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Eltern-Einstellungen -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_DisabledSubjects]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SubjectToggles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsDisabled}"
                                      Margin="0,4,24,4" FontSize="16" MinWidth="200" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_ActivityLogFor]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name" Width="240" FontSize="16" Padding="8" Margin="0,0,12,0" />
                    <!-- Löscht das gewählte Profil (mit Rückfrage; das letzte Profil bleibt geschützt). -->
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_DeleteProfile]}"
                            Style="{StaticResource RoundedButton}" Background="{StaticResource ErrorBrush}"
                            FontSize="14" Padding="14,8"
                            Command="{Binding DeleteSelectedProfileCommand}" />
                </StackPanel>

                <!-- Schwierigkeitsstufen (pro oben gewähltem Profil) - vorkonfigurierte Presets statt
                     freier Eingabe, damit Eltern keinen ungültigen Wert setzen können und kein neuer
                     Build nötig ist, um die Hürden zu verändern. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Difficulty_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,8" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Difficulty_Typing]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="25%" Style="{StaticResource TabPillButton}" Command="{Binding SetTypingMinAccuracyCommand}" CommandParameter="25">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="25" />
                                <Binding Path="TypingMinAccuracyPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="50%" Style="{StaticResource TabPillButton}" Command="{Binding SetTypingMinAccuracyCommand}" CommandParameter="50">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="50" />
                                <Binding Path="TypingMinAccuracyPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="75%" Style="{StaticResource TabPillButton}" Command="{Binding SetTypingMinAccuracyCommand}" CommandParameter="75">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="75" />
                                <Binding Path="TypingMinAccuracyPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="100%" Style="{StaticResource TabPillButton}" Command="{Binding SetTypingMinAccuracyCommand}" CommandParameter="100">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="100" />
                                <Binding Path="TypingMinAccuracyPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <!-- Wochenziel: reine Anzeige, keine Druckmechanik (siehe WeeklyGoalCalculator).
                     Anders als die Lernserie zerbricht es nicht an einem einzigen verpassten Tag. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_WeeklyGoal_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_WeeklyGoal_Hint]}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="Aus" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="0">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="0" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="3 Tage" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="3">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="3" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="4 Tage" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="4">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="4" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="5 Tage" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="5">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="5" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="6 Tage" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="6">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="6" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="7 Tage" Style="{StaticResource TabPillButton}" Command="{Binding SetWeeklyGoalCommand}" CommandParameter="7">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="7" />
                                <Binding Path="WeeklyGoalDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </WrapPanel>

                <!-- Eigene Zieltexte für die beiden letzten Tipp-Lektionen. MaxLength kappt die Eingabe
                     hart, der Zähler darunter zeigt live die Länge - so kann der Text gar nicht erst
                     zu lang werden. Zu kurze Texte werden beim Speichern verworfen (der eingebaute
                     Text bleibt dann stehen), siehe TypingTextOverrides.Sanitize. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_TypingText_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_TypingText_Hint]}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_TypingText_Sentence]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <TextBox Text="{Binding CustomTypingSentenceText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{Binding TypingTextMaxLength, Mode=OneTime}"
                         AcceptsReturn="False" TextWrapping="Wrap" MinHeight="48" Padding="6" />
                <TextBlock Text="{Binding CustomTypingSentenceTextCounter, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,12" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_TypingText_Final]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <TextBox Text="{Binding CustomTypingFinalText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{Binding TypingTextMaxLength, Mode=OneTime}"
                         AcceptsReturn="False" TextWrapping="Wrap" MinHeight="48" Padding="6" />
                <TextBlock Text="{Binding CustomTypingFinalTextCounter, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,16" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Difficulty_QuizFirst]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="50%" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizFirstAttemptThresholdCommand}" CommandParameter="50">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="50" />
                                <Binding Path="QuizFirstAttemptThresholdPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="75%" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizFirstAttemptThresholdCommand}" CommandParameter="75">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="75" />
                                <Binding Path="QuizFirstAttemptThresholdPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="85%" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizFirstAttemptThresholdCommand}" CommandParameter="85">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="85" />
                                <Binding Path="QuizFirstAttemptThresholdPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Difficulty_QuizRetry]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="25%" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizRetryThresholdCommand}" CommandParameter="25">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="25" />
                                <Binding Path="QuizRetryThresholdPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="50%" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizRetryThresholdCommand}" CommandParameter="50">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="50" />
                                <Binding Path="QuizRetryThresholdPercent" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <!-- Zeiten (pro oben gewähltem Profil): Pflicht-Lesezeit und Mindestzeiten als
                     Presets - wie die Schwierigkeitsstufen bewusst ohne freie Eingabe, damit
                     keine ungültigen Werte möglich sind und kein neuer Build nötig ist. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Timer_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,8" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Timer_Reading]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="2 min" Style="{StaticResource TabPillButton}" Command="{Binding SetReadingMinutesCommand}" CommandParameter="2">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="2" />
                                <Binding Path="ReadingMinutes" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="5 min" Style="{StaticResource TabPillButton}" Command="{Binding SetReadingMinutesCommand}" CommandParameter="5">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="5" />
                                <Binding Path="ReadingMinutes" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="8 min" Style="{StaticResource TabPillButton}" Command="{Binding SetReadingMinutesCommand}" CommandParameter="8">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="8" />
                                <Binding Path="ReadingMinutes" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="10 min" Style="{StaticResource TabPillButton}" Command="{Binding SetReadingMinutesCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="ReadingMinutes" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Timer_News]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="5 s" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsSecondsPerArticleCommand}" CommandParameter="5">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="5" />
                                <Binding Path="NewsSecondsPerArticle" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="10 s" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsSecondsPerArticleCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="NewsSecondsPerArticle" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="20 s" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsSecondsPerArticleCommand}" CommandParameter="20">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="20" />
                                <Binding Path="NewsSecondsPerArticle" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="30 s" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsSecondsPerArticleCommand}" CommandParameter="30">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="30" />
                                <Binding Path="NewsSecondsPerArticle" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Timer_NewsCount]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="6" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsArticleCountCommand}" CommandParameter="6">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="6" />
                                <Binding Path="NewsArticleCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="10" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsArticleCountCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="NewsArticleCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="12" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsArticleCountCommand}" CommandParameter="12">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="12" />
                                <Binding Path="NewsArticleCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="15" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsArticleCountCommand}" CommandParameter="15">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="15" />
                                <Binding Path="NewsArticleCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="20" Style="{StaticResource TabPillButton}" Command="{Binding SetNewsArticleCountCommand}" CommandParameter="20">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="20" />
                                <Binding Path="NewsArticleCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Timer_Exercise]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="3 s" Style="{StaticResource TabPillButton}" Command="{Binding SetExerciseSecondsPerQuestionCommand}" CommandParameter="3">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="3" />
                                <Binding Path="ExerciseSecondsPerQuestion" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="5 s" Style="{StaticResource TabPillButton}" Command="{Binding SetExerciseSecondsPerQuestionCommand}" CommandParameter="5">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="5" />
                                <Binding Path="ExerciseSecondsPerQuestion" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="10 s" Style="{StaticResource TabPillButton}" Command="{Binding SetExerciseSecondsPerQuestionCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="ExerciseSecondsPerQuestion" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="15 s" Style="{StaticResource TabPillButton}" Command="{Binding SetExerciseSecondsPerQuestionCommand}" CommandParameter="15">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="15" />
                                <Binding Path="ExerciseSecondsPerQuestion" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <!-- Umfang (pro oben gewähltem Profil): Aufgaben pro Fach und Quiz-Längen als
                     Presets - steuert direkt die Dauer der Tagessession, ohne neuen Build. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Scope_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,8" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Scope_Exercises]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="4" Style="{StaticResource TabPillButton}" Command="{Binding SetExercisesPerSubjectCommand}" CommandParameter="4">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="4" />
                                <Binding Path="ExercisesPerSubject" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="6" Style="{StaticResource TabPillButton}" Command="{Binding SetExercisesPerSubjectCommand}" CommandParameter="6">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="6" />
                                <Binding Path="ExercisesPerSubject" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="8" Style="{StaticResource TabPillButton}" Command="{Binding SetExercisesPerSubjectCommand}" CommandParameter="8">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="8" />
                                <Binding Path="ExercisesPerSubject" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="10" Style="{StaticResource TabPillButton}" Command="{Binding SetExercisesPerSubjectCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="ExercisesPerSubject" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Scope_QuizFirst]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="10" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizQuestionCountCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="QuizQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="15" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizQuestionCountCommand}" CommandParameter="15">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="15" />
                                <Binding Path="QuizQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="20" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizQuestionCountCommand}" CommandParameter="20">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="20" />
                                <Binding Path="QuizQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="25" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizQuestionCountCommand}" CommandParameter="25">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="25" />
                                <Binding Path="QuizQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Scope_QuizRetry]}"
                           Style="{StaticResource BodyText}" FontSize="14" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="10" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizRetryQuestionCountCommand}" CommandParameter="10">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="10" />
                                <Binding Path="QuizRetryQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="15" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizRetryQuestionCountCommand}" CommandParameter="15">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="15" />
                                <Binding Path="QuizRetryQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="20" Style="{StaticResource TabPillButton}" Command="{Binding SetQuizRetryQuestionCountCommand}" CommandParameter="20">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="20" />
                                <Binding Path="QuizRetryQuestionCount" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <!-- Ferien-/Pausenmodus (global, nicht pro Profil): bis einschließlich des Datums
                     startet die App ohne Kiosk-Sperre; danach reaktiviert sie sich von selbst. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Pause_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,8" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Pause_Hint]}"
                           Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <DatePicker SelectedDate="{Binding PauseUntil}" FontSize="14" Width="180" Margin="0,0,12,0" />
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Pause_Clear]}"
                            Style="{StaticResource RoundedButton}" FontSize="13" Padding="12,6"
                            Command="{Binding ClearPauseUntilCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Pause_Active]}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding IsPauseActive, Converter={StaticResource BoolToVis}}" />

                <!-- 🔥-Lernserie: reine Anzeige-Motivation, Standard aus (bewusst kein
                     Streak-Druck bei verpassten Tagen - keine Strafen, keine Erinnerungen). -->
                <CheckBox IsChecked="{Binding StreaksEnabled}" Margin="0,4,0,16" FontSize="14"
                          Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Streaks_Toggle]}" />

                <ListView ItemsSource="{Binding RecentActivity}" MaxHeight="220" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Zeit" DisplayMemberBinding="{Binding Timestamp}" Width="140" />
                            <GridViewColumn Header="Fach" DisplayMemberBinding="{Binding Subject}" Width="90" />
                            <GridViewColumn Header="Thema" DisplayMemberBinding="{Binding Topic}" Width="160" />
                            <GridViewColumn Header="Richtig?" DisplayMemberBinding="{Binding WasCorrect}" Width="70" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Wochen-/Monatsbericht: Stärken/Schwächen je Fach (schwächste zuerst), Lerntage,
                     Quiz-Verlauf - für das oben gewählte Profil. -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Report_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,24,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Report_Days7]}"
                            Style="{StaticResource TabPillButton}" Command="{Binding SetReportPeriodCommand}" CommandParameter="7">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="7" />
                                <Binding Path="ReportDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Report_Days30]}"
                            Style="{StaticResource TabPillButton}" Command="{Binding SetReportPeriodCommand}" CommandParameter="30">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="30" />
                                <Binding Path="ReportDays" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Report_NoData]}"
                           Style="{StaticResource BodyText}" Opacity="0.7"
                           Visibility="{Binding HasReportData, Converter={StaticResource InverseBoolToVis}}" />

                <StackPanel Visibility="{Binding HasReportData, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ReportRows}" ItemTemplate="{StaticResource ReportRowTemplate}" />

                    <!-- Themen-Heatmap: die schwächsten EINZEL-Themen (nicht nur Fächer) - damit
                         Eltern sehen, dass z.B. genau "Brüche" hakt und nicht pauschal "Mathe". -->
                    <StackPanel Visibility="{Binding HasTopicReportData, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Report_WeakTopics]}"
                                   Style="{StaticResource BodyText}" FontWeight="Bold" FontSize="14" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding TopicReportRows}" ItemTemplate="{StaticResource ReportRowTemplate}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ReportLearnedDaysDisplay}" Style="{StaticResource BodyText}" FontSize="14" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ReportQuizTrendDisplay}" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <!-- Antworttempo: im Richtig/Falsch-Bericht ist Raten unsichtbar (bei drei
                         Optionen liegt Raten in einem Drittel der Fälle richtig). Die Warnzeile
                         erscheint nur, wenn wirklich auffällig schnell geantwortet wurde. -->
                    <TextBlock Text="{Binding ReportWeeklyGoalDisplay}" Style="{StaticResource BodyText}"
                               FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <!-- Lernzeit je Fach: zeigt, WARUM ein Fach schlecht laeuft. Eine niedrige
                         Trefferquote allein unterscheidet nicht zwischen "geraten" und "nicht
                         verstanden" - die beiden brauchen aber sehr verschiedene Reaktionen. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding HasSubjectTimeData, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏱ Lernzeit je Fach" Style="{StaticResource SubtitleText}"
                                   FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SubjectTimeSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding SubjectTimeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                            Padding="10,6" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SubjectLabel, Mode=OneWay}"
                                                           Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EffortDisplay, Mode=OneWay}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsAttention, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding TotalTimeDisplay, Mode=OneWay}"
                                                           Style="{StaticResource BodyText}" FontWeight="Bold"
                                                           FontSize="13" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding MedianDisplay, Mode=OneWay}"
                                                           Style="{StaticResource BodyText}" FontSize="11"
                                                           Opacity="0.7" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding AccuracyDisplay, Mode=OneWay}"
                                                           Style="{StaticResource BodyText}" FontSize="11"
                                                           Opacity="0.7" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding ReportPaceDisplay}" Style="{StaticResource BodyText}"
                               FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReportPaceWarningDisplay}" Style="{StaticResource BodyText}"
                               FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource ErrorBrush}"
                               Visibility="{Binding HasPaceWarning, Converter={StaticResource BoolToVis}}" />

                    <!-- Bericht als Datei: HTML statt PDF - eine einzelne, eigenstaendige Datei
                         oeffnet jeder Rechner ohne Zusatzsoftware, und "Drucken → Als PDF
                         speichern" erzeugt das PDF genau dann, wenn es gebraucht wird. Eine
                         PDF-Bibliothek waere eine weitere Abhaengigkeit im self-contained Build
                         fuer ein Ergebnis, das der Browser ohnehin liefert. -->
                    <Button Content="📄 Bericht als Datei speichern…" Style="{StaticResource RoundedButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding ExportReportCommand}" />
                    <TextBlock Text="{Binding ReportExportStatus, Mode=OneWay}"
                               Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Geschwister-Vergleich: bewusst ABSCHALTBAR und standardmäßig aus. Ob es einer
                     Familie hilft, die Kinder nebeneinander zu sehen, oder ob es das Kind
                     entmutigt, das immer hinten liegt, können nur die Eltern beurteilen - also
                     eine bewusste Entscheidung statt einer Voreinstellung. Die Tabelle steht
                     bewusst AUSSERHALB des HasReportData-Blocks: sie hängt nicht am gewählten
                     Kind, und wenn genau dieses Kind nichts gemacht hat, ist das die
                     interessanteste Zeile. Sortiert nach Namen, nicht nach Leistung - kein
                     Siegertreppchen (siehe ProfileComparison). -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Title]}"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,24,0,6" />
                <CheckBox IsChecked="{Binding ProfileComparisonEnabled}" FontSize="14" Margin="0,0,0,4"
                          Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Toggle]}" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Explainer]}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{Binding ProfileComparisonHint, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasProfileComparisonHint, Converter={StaticResource BoolToVis}}" />

                <StackPanel Visibility="{Binding HasProfileComparisonData, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="10,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="12" Opacity="0.7"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Child]}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Days]}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource BodyText}" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Accuracy]}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource BodyText}" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Time]}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource BodyText}" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Parent_Comparison_Stars]}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProfileComparisonRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                        Padding="10,7" Margin="0,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}"
                                                       Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding LearnedDaysDisplay, Mode=OneWay}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding AccuracyDisplay, Mode=OneWay}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding LearningTimeDisplay, Mode=OneWay}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding StarsDisplay, Mode=OneWay}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding EmptyHint, Mode=OneWay}"
                                                   Style="{StaticResource BodyText}" FontSize="11" Opacity="0.6"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Eigene Aufgaben (z.B. aktuelle Hausaufgaben der Lehrkraft) -->
                <!-- Eigene Lesetexte: gehören zum oben gewählten Profil. Ein eigener Text belegt
                     einen der beiden Tagesplätze (siehe ReadingContentProvider.GetPairForDate) -
                     ein Gedicht für nächste Woche nützt nichts, wenn es erst in zwei Monaten kommt. -->
                <!-- Vokabeltrainer: Massen-Eingabe statt Einzelfelder - niemand tippt dreißig
                     Wortpaare in einzelne Formulare. Die Vokabeln laufen in den bestehenden
                     Fächern Englisch/Türkisch mit, ersetzen dort bis zur Hälfte der Aufgaben. -->
                <!-- Verwaltungsliste ALLER Lesetexte (eingebaut + eigene). Die 63 eingebauten
                     Stuecke waren im Eltern-Bereich vorher gar nicht sichtbar, und ein frisch
                     eingetragener eigener Text liess sich nicht gezielt aufrufen - das Anheften
                     loest genau das. -->
                <!-- Klausurkalender: gehoert zum oben gewaehlten Profil. Kinder duerfen selbst
                     eintragen (Herkunft steht an jeder Zeile); hier duerfen die Eltern alles. -->
                <TextBlock Text="📅 Klausuren (für das oben gewählte Kind)"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,4" />
                <TextBlock Text="Ab einer Woche vor dem Termin bekommt das Fach automatisch mehr Übungsaufgaben, je näher desto mehr. Die Kinder sehen einen Countdown auf dem Startbildschirm."
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ExamStatus, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="📅 Klausur eintragen" Style="{StaticResource RoundedButton}"
                            Margin="0,0,8,0" Command="{Binding AddExamCommand}" />
                    <Button Content="Vergangene älter als 30 Tage aufräumen" Style="{StaticResource RoundedButton}"
                            Command="{Binding ClearPastExamsCommand}" />
                </StackPanel>

                <!-- ICS statt Cloud-Anbindung: offener Standard, den Schulportal, Outlook, Apple
                     und Google alle koennen - ohne Konto, ohne Netz, ohne Browserfenster. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="📥 Aus Kalenderdatei (.ics) einlesen" Style="{StaticResource RoundedButton}"
                            Margin="0,0,8,0" Command="{Binding ImportExamsCommand}" />
                    <Button Content="📤 Als .ics exportieren" Style="{StaticResource RoundedButton}"
                            Command="{Binding ExportExamsCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Exams}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Topics, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                                   Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SubjectName, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                       FontSize="11" Opacity="0.7" />
                                            <TextBlock Text=" · " Style="{StaticResource BodyText}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding AuthorLabel, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                       FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Countdown, Mode=OneWay}" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImminent, Mode=OneWay}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPast, Mode=OneWay}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DateLabel, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                   FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🗑" Style="{StaticResource RoundedButton}"
                                            Padding="8,2" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteExamCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Jugendschutz-Stufe: die harte Sperre gilt immer, einstellbar ist nur der
                     Umgang mit heiklen, aber lehrplanrelevanten Themen. -->
                <TextBlock Text="🛡 News-Filter (für das oben gewählte Kind)"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Streng" Style="{StaticResource TabPillButton}"
                            Command="{Binding SetNewsFilterStrictnessCommand}" CommandParameter="Streng">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="Streng" />
                                <Binding Path="NewsFilterStrictness" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="Normal" Style="{StaticResource TabPillButton}"
                            Command="{Binding SetNewsFilterStrictnessCommand}" CommandParameter="Normal">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="Normal" />
                                <Binding Path="NewsFilterStrictness" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                    <Button Content="Locker" Style="{StaticResource TabPillButton}"
                            Command="{Binding SetNewsFilterStrictnessCommand}" CommandParameter="Locker">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource EqualsToSelectedTag}">
                                <Binding Source="Locker" />
                                <Binding Path="NewsFilterStrictness" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding NewsFilterStrictnessHint, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.8"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- Hausaufgaben mit Stichtag: gehoeren zum oben gewaehlten Profil. Anders als die
                     eigenen Aufgaben weiter oben werden sie NICHT abgefragt - sie erinnern nur an
                     etwas, das ausserhalb der App zu erledigen ist. -->
                <TextBlock Text="📒 Hausaufgaben (für das oben gewählte Kind)"
                           Style="{StaticResource SubtitleText}" FontWeight="Bold" Margin="0,20,0,4" />
                <TextBlock Text="Erscheinen beim Kind auf dem Startbildschirm und werden dort abgehakt. Überfällige stehen ganz oben und rot."
                           Style="{StaticResource BodyText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="{Binding HomeworkStatus, Mode=OneWay}"
                           Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding HomeworkSubjects}" SelectedItem="{Binding NewHomeworkSubject}"
                              Width="150" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding NewHomeworkDueDate}" Width="130"
                                Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding NewHomeworkDescription, UpdateSourceTrigger=PropertyChanged}"
                             Width="280" Margin="0,0,8,0" VerticalAlignment="Center"
                             ToolTip="Was ist zu tun? z.B. &quot;Mathe Seite 42, Nr. 1-5&quot;" />
                    <Button Content="Eintragen" Style="{StaticResource RoundedButton}"
                            Command="{Binding AddHomeworkCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Homework}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SubjectName, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                       FontSize="11" Opacity="0.7" />
                                            <TextBlock Text=" · " Style="{StaticResource BodyText}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding AuthorLabel, Mode=OneWay}" Style="{StaticResource BodyText}"
                                                       FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DueLabel, Mode=OneWay}"
                                               VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock.Style>
