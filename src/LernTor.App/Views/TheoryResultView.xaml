<UserControl x:Class="LernTor.App.Views.TheoryResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization"
             xmlns:controls="clr-namespace:LernTor.App.Controls">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Ergebnis ===================== -->
        <StackPanel Grid.Row="0" Margin="32,48,32,12" HorizontalAlignment="Center" MaxWidth="820">
            <TextBlock Text="{Binding Headline, Mode=OneWay}" Style="{StaticResource HeadlineText}"
                       FontSize="32" TextAlignment="Center"
                       Foreground="{Binding Passed, Converter={StaticResource BoolToSuccessBrushConverter}}" />

            <!-- Die Fehlerpunkte stehen groß und die Prozentzahl gar nicht: in der Prüfung
                 entscheiden die Punkte, und 28 von 30 richtig können trotzdem durchgefallen sein. -->
            <TextBlock Text="{Binding PointsDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="22" TextAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="{Binding CountDisplay, Mode=OneWay}" Style="{StaticResource BodyText}"
                       FontSize="15" TextAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Reason, Mode=OneWay}" Style="{StaticResource BodyText}"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource ErrorBrush}"
                       Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel HorizontalAlignment="Center" MaxWidth="820">

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamNoMistakes]}"
                           Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasMistakes, Converter={StaticResource InverseBoolToVis}}" />

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamMistakes]}"
                           FontSize="20" FontWeight="SemiBold" Margin="4,8,0,10"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Visibility="{Binding HasMistakes, Converter={StaticResource BoolToVis}}" />

                <!-- Jede falsche Frage einzeln, mit Begründung. Das ist der Ertrag des
                     Durchlaufs - die Punktzahl allein bringt niemanden weiter. -->
                <ItemsControl ItemsSource="{Binding Mistakes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:TrafficSignVisual Grid.Column="0" Width="72" Height="72"
                                                                Margin="0,0,16,0" VerticalAlignment="Top"
                                                                Sign="{Binding Sign}"
                                                                Visibility="{Binding Sign, Converter={StaticResource NullToVis}}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Topic}" Style="{StaticResource BodyText}"
                                                   FontSize="12" Opacity="0.8" />
                                        <TextBlock Text="{Binding Prompt}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,2,0,8"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamYourAnswer]}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                            <TextBlock Text=": " Style="{StaticResource BodyText}" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChosenDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamCorrectAnswer]}"
                                                       Style="{StaticResource BodyText}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            <TextBlock Text=": " Style="{StaticResource BodyText}" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CorrectDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodyText}"
                                                   FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                                                   Opacity="0.9" />
                                        <TextBlock Text="{Binding PointsDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="16" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,28">
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ExamRepeat]}"
                    Style="{StaticResource RoundedButton}" Margin="0,0,10,0"
                    Command="{Binding RepeatCommand}" />
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Back]}"
                    Style="{StaticResource RoundedButton}"
                    Background="{StaticResource TextSecondaryBrush}"
                    Command="{Binding BackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
