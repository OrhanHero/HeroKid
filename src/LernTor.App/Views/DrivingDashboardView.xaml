<UserControl x:Class="LernTor.App.Views.DrivingDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization"
             xmlns:controls="clr-namespace:LernTor.App.Controls">
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Kopf ===================== -->
        <StackPanel Grid.Row="0" Margin="32,56,32,12" HorizontalAlignment="Center" MaxWidth="1000">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Title]}"
                       Style="{StaticResource HeadlineText}" FontSize="32" TextAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Intro]}"
                       Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding OverallDisplay, Mode=OneWay}"
                       Style="{StaticResource SubtitleText}" FontSize="15" TextAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1000">

                <!-- ============ Tägliche Challenge (der Pflichtteil) ============ -->
                <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,0,0,20"
                        Background="{StaticResource TileSandBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Challenge]}"
                                       FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ChallengeHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_ChallengeStart]}"
                                Style="{StaticResource RoundedButton}"
                                Command="{Binding StartChallengeCommand}" />
                    </Grid>
                </Border>

                <!-- ============ Unterbereich 1: Verkehrszeichen ============ -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaSigns]}"
                           FontSize="22" FontWeight="SemiBold" Margin="4,0,0,2"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaSignsHint]}"
                           Style="{StaticResource BodyText}" Margin="4,0,0,12" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vorschaubild: ein echtes Zeichen der Gruppe sagt mehr als ihr Name -->
                                    <controls:TrafficSignVisual Grid.Column="0" Width="64" Height="64"
                                                                Margin="0,0,16,0" VerticalAlignment="Center"
                                                                Sign="{Binding Sample}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Border Background="{StaticResource TileMintBrush}" CornerRadius="10"
                                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Recommended]}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" />
                                        <ProgressBar Style="{StaticResource ChildProgressBar}" Height="8"
                                                     Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
                                        <TextBlock Text="{Binding ProgressDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Flashcards]}"
                                                Style="{StaticResource RoundedButton}" FontSize="14" Padding="16,8"
                                                Background="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"
                                                Command="{Binding DataContext.StartFlashcardsCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Quiz]}"
                                                Style="{StaticResource RoundedButton}" FontSize="14" Padding="16,8"
                                                Command="{Binding DataContext.StartQuizCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============ Unterbereich 2: Theoriefragen ============ -->
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaTheory]}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaTheoryHint]}"
                                       Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TheoryProgressDisplay, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaTheoryOpen]}"
                                Style="{StaticResource RoundedButton}" FontSize="14" Padding="18,8"
                                Command="{Binding OpenTheoryCommand}" />
                    </Grid>
                </Border>

                <!-- ============ Unterbereich 3: noch nicht befüllt ============
                     Bewusst sichtbar statt versteckt: die Kinder sollen sehen, wohin der
                     Bereich geht. Der Zustand steht dran, damit niemand vergeblich klickt. -->
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,10,0,24" Opacity="0.6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaCourse]}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_AreaCourseHint]}"
                                   Style="{StaticResource BodyText}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Weiter erst nach der Challenge - sie ist der Pflichtteil dieses Bereichs. -->
        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,28"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Fs_Next]}"
                Style="{StaticResource RoundedButton}"
                IsEnabled="{Binding CanContinue}"
                Command="{Binding ContinueCommand}" />
    </Grid>
</UserControl>
