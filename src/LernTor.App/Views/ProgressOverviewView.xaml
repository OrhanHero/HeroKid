<UserControl x:Class="LernTor.App.Views.ProgressOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization">
    <!-- "Mein Fortschritt": Meisterschaft je Thema (TopicMasteryCalculator). Nur Anzeige - kein
         Knopf hier schaltet etwas frei oder ueberspringt etwas. -->
    <Grid Background="{StaticResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,40,32,12" HorizontalAlignment="Center" MaxWidth="900">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Title]}"
                       Style="{StaticResource HeadlineText}" FontSize="32" TextAlignment="Center" />
            <TextBlock Text="{Binding SummaryDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_HowTo]}"
                       Style="{StaticResource BodyText}" FontSize="14" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"
                       Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel HorizontalAlignment="Center" MaxWidth="900" MinWidth="560">

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Empty]}"
                           Style="{StaticResource BodyText}" FontSize="18" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,40,0,0"
                           Visibility="{Binding HasTopics, Converter={StaticResource InverseBoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Subjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{Binding Subject, Converter={StaticResource SubjectToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="14" VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Topics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="170" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Topic}" FontSize="16"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailDisplay}"
                                                               Style="{StaticResource BodyText}" FontSize="13"
                                                               VerticalAlignment="Center" Margin="12,0,12,0" />

                                                    <!-- Hintergrund NUR ueber den Style: Attribut und Style-Setter
                                                         zugleich waere eine stille Rangfolge-Falle. -->
                                                    <Border Grid.Column="2" CornerRadius="12" Padding="10,4"
                                                            HorizontalAlignment="Stretch">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource TileSandBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Vertraut">
                                                                        <Setter Property="Background" Value="{StaticResource TileLavenderBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Sicher">
                                                                        <Setter Property="Background" Value="{StaticResource TileMintBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Gemeistert">
                                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding LevelDisplay}" FontSize="14" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="16" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,28"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Back]}"
                Style="{StaticResource RoundedButton}"
                Command="{Binding BackCommand}" />
    </Grid>
</UserControl>
