<UserControl x:Class="LernTor.App.Views.ProgressOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LernTor.App.Localization">
    <!-- "Mein Fortschritt": Meisterschaft je Thema (TopicMasteryCalculator). Nur Anzeige - kein
         Knopf hier schaltet etwas frei oder ueberspringt etwas. -->
    <Grid Background="{DynamicResource BackgroundBrush}" Style="{StaticResource FadeInOnLoad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,40,32,12" HorizontalAlignment="Center" MaxWidth="900">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Title]}"
                       Style="{StaticResource HeadlineText}" FontSize="32" TextAlignment="Center" />
            <TextBlock Text="{Binding SummaryDisplay, Mode=OneWay}" Style="{StaticResource SubtitleText}"
                       FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_HowTo]}"
                       Style="{StaticResource BodyText}" FontSize="14" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"
                       Visibility="{Binding HasTopics, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,0">
            <StackPanel HorizontalAlignment="Center" MaxWidth="900" MinWidth="560">

                <!-- Lernkalender (3.1): die letzten zwoelf Wochen, eine Spalte je Woche. Bewusst
                     ohne Serie, die reissen kann. Form UND Farbe unterscheiden die Tage: gelernt =
                     gefuellt mit Haekchen, Schultag = blass gefuellt, schulfrei = nur Rand. -->
                <Border Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,0,0,14"
                        Visibility="{Binding HasCalendar, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_CalendarTitle]}"
                                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CalendarSummary, Mode=OneWay}" Style="{StaticResource BodyText}"
                                   FontSize="15" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding WeekdayLabels}" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Height="22" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,4,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="22" Height="22" Margin="0,0,0,4" CornerRadius="5"
                                                            BorderThickness="2" ToolTip="{Binding ToolTip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ProgressTrackBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Gelernt">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Schulfrei">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Zukunft">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource OnColorBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Gelernt">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Legende -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Calendar_Gelernt]}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource ProgressTrackBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Calendar_Schultag]}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                            <Border Width="14" Height="14" CornerRadius="3" BorderThickness="2"
                                    BorderBrush="{DynamicResource ProgressTrackBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Calendar_Schulfrei]}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Abzeichen: freigeschaltete farbig (heute neue golden umrandet), offene blass
                     mit dem Hinweis, wie man sie bekommt. Nichts davon verfaellt. -->
                <Border Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,0,0,14"
                        Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AchievementsHeadline, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Achievements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Margin="0,0,10,10" Padding="12,10" CornerRadius="16"
                                            BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TileSandBrush}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Emoji}" FontSize="30" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,2"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding DetailDisplay}" Style="{StaticResource BodyText}"
                                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Empty]}"
                           Style="{StaticResource BodyText}" FontSize="18" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,40,0,0"
                           Visibility="{Binding HasTopics, Converter={StaticResource InverseBoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Subjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{Binding Subject, Converter={StaticResource SubjectToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SummaryDisplay}" Style="{StaticResource BodyText}"
                                                   FontSize="14" VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Topics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="170" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Topic}" FontSize="16"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailDisplay}"
                                                               Style="{StaticResource BodyText}" FontSize="13"
                                                               VerticalAlignment="Center" Margin="12,0,12,0" />

                                                    <!-- Hintergrund NUR ueber den Style: Attribut und Style-Setter
                                                         zugleich waere eine stille Rangfolge-Falle. -->
                                                    <Border Grid.Column="2" CornerRadius="12" Padding="10,4"
                                                            HorizontalAlignment="Stretch">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource TileSandBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Vertraut">
                                                                        <Setter Property="Background" Value="{DynamicResource TileLavenderBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Sicher">
                                                                        <Setter Property="Background" Value="{DynamicResource TileMintBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Gemeistert">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding LevelDisplay}" FontSize="14" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="16" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,28"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Progress_Back]}"
                Style="{StaticResource RoundedButton}"
                Command="{Binding BackCommand}" />
    </Grid>
</UserControl>
