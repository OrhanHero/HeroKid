<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design-Tokens des Standard-Designs "Lavendel" (docs/DESIGN.md). Die Werte stehen
         identisch in LernTor.Core/Design/DesignThemeCatalog.cs - DesignThemeCatalogTests prüft
         das. Zur Laufzeit legt ThemeService das gewählte Design als letztes Wörterbuch darüber;
         deshalb verwenden die Ansichten diese Pinsel NUR per DynamicResource (preflight.py
         prüft es), sonst behält eine Stelle beim Umschalten die alte Farbe. -->

    <Color x:Key="PrimaryColor">#6352E0</Color>
    <Color x:Key="PrimaryDarkColor">#4834D4</Color>
    <Color x:Key="AccentColor">#FDCB6E</Color>
    <Color x:Key="SuccessColor">#00806A</Color>
    <Color x:Key="ErrorColor">#C0392B</Color>
    <Color x:Key="BackgroundColor">#F5F6FA</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#2D3436</Color>
    <Color x:Key="TextSecondaryColor">#5F6A6E</Color>
    <Color x:Key="OnColorColor">#FFFFFF</Color>
    <Color x:Key="FocusColor">#B9770E</Color>
    <Color x:Key="MathColor">#0984E3</Color>
    <Color x:Key="GermanColor">#6352E0</Color>
    <Color x:Key="TurkishColor">#D63384</Color>
    <Color x:Key="ScienceColor">#00806A</Color>
    <Color x:Key="NewsColor">#B9770E</Color>
    <Color x:Key="TileLavenderColor">#EDEAFB</Color>
    <Color x:Key="TileSandColor">#FEF3DC</Color>
    <Color x:Key="TileMintColor">#DFF7F0</Color>
    <Color x:Key="TileRoseColor">#FDEAF2</Color>
    <Color x:Key="ProgressTrackColor">#E4E6F0</Color>
    <Color x:Key="InputBorderColor">#DDE1EA</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="OnColorBrush" Color="{StaticResource OnColorColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="MathBrush" Color="{StaticResource MathColor}" />
    <SolidColorBrush x:Key="GermanBrush" Color="{StaticResource GermanColor}" />
    <SolidColorBrush x:Key="TurkishBrush" Color="{StaticResource TurkishColor}" />
    <SolidColorBrush x:Key="ScienceBrush" Color="{StaticResource ScienceColor}" />
    <SolidColorBrush x:Key="NewsBrush" Color="{StaticResource NewsColor}" />
    <SolidColorBrush x:Key="TileLavenderBrush" Color="{StaticResource TileLavenderColor}" />
    <SolidColorBrush x:Key="TileSandBrush" Color="{StaticResource TileSandColor}" />
    <SolidColorBrush x:Key="TileMintBrush" Color="{StaticResource TileMintColor}" />
    <SolidColorBrush x:Key="TileRoseBrush" Color="{StaticResource TileRoseColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />

    <!-- Schrift des Designs (Standard: Segoe UI). Wird wie die Farben zur Laufzeit getauscht. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
