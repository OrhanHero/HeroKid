<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LernTor.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>LernTor</AssemblyName>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Nur für Restore/Publish relevant (RID-spezifische Assets) - dotnet build/run bleibt
         davon unberührt, SelfContained/PublishSingleFile/PublishReadyToRun werden bewusst erst
         am `dotnet publish`-Aufruf gesetzt (siehe docs/BUILD.md), damit CI-Build/-Test (die kein
         Publish machen) unverändert bleiben. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Original-Bilddateien der 77 Verkehrszeichen (PNG, gemeinfrei, siehe
       docs/FUEHRERSCHEIN.md). Build-Aktion "Resource" bettet sie in die Assembly ein statt sie
       als lose Dateien neben der EXE abzulegen - sie überstehen damit den
       Single-File-Publish unverändert und die App bleibt vollständig offline, es wird zur
       Laufzeit nichts nachgeladen. -->
  <ItemGroup>
    <Resource Include="Assets\Verkehrszeichen\*.png" />
  </ItemGroup>

  <!-- Bilder der sieben Weltwunder der Antike - KI-generierte Rekonstruktionen, von der Familie
       selbst erstellt (siehe Assets\Weltwunder\QUELLEN.md). Sechs der sieben Bauwerke existieren
       nicht mehr, ein Foto davon kann es also gar nicht geben.
       Das Platzhalter-Muster ist Absicht: solange noch keine Datei im Ordner liegt, greift es
       einfach ins Leere, statt den Build mit einer fehlenden Datei scheitern zu lassen. -->
  <ItemGroup>
    <Resource Include="Assets\Weltwunder\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LernTor.Core\LernTor.Core.csproj" />
    <ProjectReference Include="..\LernTor.ContentGen\LernTor.ContentGen.csproj" />
    <ProjectReference Include="..\LernTor.News\LernTor.News.csproj" />
    <ProjectReference Include="..\LernTor.Data\LernTor.Data.csproj" />
    <ProjectReference Include="..\LernTor.Security\LernTor.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Vorlesefunktion (TTS) im Lesen-Abschnitt: Windows-eigene Sprachausgabe, komplett offline -
         passt zum Kein-Cloud-Prinzip der App. Version gegen die echte nuget.org-Versionshistorie
         geprüft (8.0.0 ist die stabile net8.0-Ausgabe). -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- LLamaSharp sucht seine nativen Bibliotheken (llama.dll/ggml*.dll) selbst per Dateipfad
       relativ zur EXE, statt sie über den normalen .NET-Ladeweg aufzulösen. Steckten sie im
       Single-File-Bundle, wären sie für diese eigene Suche unsichtbar - Folge auf installierten
       Rechnern: "The type initializer for 'LLama.Native.NativeApi' threw an exception"
       (realer Bug aus dem Familientest, zweimal aufgetreten).

       Deshalb bleiben native Bibliotheken beim Single-File-Publish als lose Dateien neben der EXE
       liegen. Das ist seit .NET 6 ohnehin das Standardverhalten - der frühere Versuch, das über
       einen eigenen MSBuild-Target mit ExcludeFromSingleFile zu erzwingen, lief ins Leere, weil
       das Publish-Kommando gleichzeitig IncludeNativeLibrariesForSelfExtract=true setzte und
       RID-spezifische Assets ihren runtimes/-Pfad beim Publish ohnehin verlieren.

       Die Eigenschaft steht hier zusätzlich explizit, damit auch ein von Hand ausgeführtes
       `dotnet publish` ohne die dokumentierten Flags ein funktionierendes Ergebnis liefert.
       Ein -p:IncludeNativeLibrariesForSelfExtract=true auf der Kommandozeile würde sie allerdings
       überstimmen - deshalb prüft der CI-Lauf zusätzlich, ob llama.dll wirklich lose vorliegt. -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
